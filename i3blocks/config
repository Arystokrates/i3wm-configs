[time]
command=echo "$($SCRIPTS_DIR/time/time.sh)                                                                 "
interval=60

[brightness]
command=$SCRIPTS_DIR/brightness/brightness.sh
interval=once
signal=1

[separator]
command=echo ""
interval=once

[battery]
command=$SCRIPTS_DIR/battery/battery.sh
interval=30

[power]
command=echo "⚡$($SCRIPTS_DIR/power/power.sh)"
interval=5

[separator]
command=echo " "
interval=once
